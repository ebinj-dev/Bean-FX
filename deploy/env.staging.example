# BEAN FX staging environment template — M35 Track J
# Copy to the host as /home/beanfx/.env.staging (mode 600, owned by the service user).
# NEVER commit real secrets: every credential below is a placeholder (__SET_ON_HOST__).

# Database — SQLite for the recommended single-server topology (M35_DATABASE_DECISION).
DATABASE_URL="file:/home/beanfx/data/beanfx-staging.db"

# Media root — absolute dedicated directory (media-storage.ts refuses fs roots).
BEANFX_DATA_DIR="/home/beanfx/data/media-store"

# Public URL used for absolute links/preview embeds.
PUBLIC_APP_URL="https://staging.__SET_ON_HOST__"

# Server port.
PORT="3000"

# Provider CLI path (BEANFX uses a CLI binary, not embedded SDK keys).
BEANFX_ZAI_BIN="__SET_ON_HOST__"

# Provider credentials — inject on the host only (M35_DEPLOYMENT_SECURITY §3).
# ASR_PROVIDER_KEY="__SET_ON_HOST__"
# IMAGE_PROVIDER_KEY="__SET_ON_HOST__"

# RATE_LIMIT_SCALE must remain UNSET in staging/production (test-only scaling env).
