# BEAN FX — staging environment template (M36 Phase B-A)
# Copy to the host as /home/beanfx/.env.staging (mode 600, owned by the service user).
# Every credential is a placeholder (__SET_ON_HOST__). NEVER commit real secrets.
# Validation: bun scripts/m36-validate-env.ts --env /home/beanfx/.env.staging [--strict]
#
# ============ REQUIRED (deployment fails clearly without these) ============
# SQLite database file. The directory must exist and be writable by the service
# user. Do NOT point at the development default (db/custom.db) in staging.
DATABASE_URL="file:/home/beanfx/data/beanfx-staging.db"

# Persistent media root — absolute dedicated directory (media-storage.ts refuses
# filesystem roots and empty values). All uploads/exports/masks live under it.
BEANFX_DATA_DIR="/home/beanfx/data/media-store"

# ============ OPTIONAL (sane defaults; adjust per host) ============
# Server bind. Keep the app on loopback/private and expose only via the TLS
# reverse proxy (M36_SERVICE_AND_REVERSE_PROXY.md).
PORT="3000"
BIND_HOST="127.0.0.1"

# Public base URL used for absolute links/preview embeds (no default — set it
# or leave commented; absence is CONFIGURATION REQUIRED, not a crash).
# PUBLIC_APP_URL="https://staging.__SET_ON_HOST__"

# ============ PROVIDER-SPECIFIC (disabled/unconfigured by default) ============
# BEAN FX calls AI providers through a CLI binary. An unconfigured provider is
# CONFIGURATION REQUIRED — it must NOT make the core editor unhealthy
# (M36_HEALTH_AND_OBSERVABILITY.md). Paid generation additionally requires the
# owner-approved budget/approval gates, which remain ON and are not configurable
# here by design.
# BEANFX_ZAI_BIN="__SET_ON_HOST__"

# ============ FORBIDDEN IN STAGING/PRODUCTION ============
# RATE_LIMIT_SCALE — test-only rate-limit scaling env. Must remain UNSET.
#   (m36-validate-env.ts fails if it is set outside NODE_ENV=development.)

# ============ SERVICE WIRING (systemd template consumes this file) ============
# EnvironmentFile=/home/beanfx/.env.staging   (see deploy/systemd/beanfx.service.template)
