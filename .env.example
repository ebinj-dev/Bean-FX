# BEAN FX — example environment configuration.
# Copy to .env and adjust for your machine. NEVER commit a real .env.

# ---------------------------------------------------------------------------
# SQLite database location (Prisma).
#   - Relative paths resolve against the project working directory.
#   - Absolute paths (Windows e.g. D:\BeanFX Data\db\custom.db) are supported.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./db/custom.db"

# ---------------------------------------------------------------------------
# ASR (speech-to-text) provider used for transcription.
# Values are read by src/lib/asr-providers.ts; leave empty to use defaults.
# ---------------------------------------------------------------------------
BEANFX_ASR_PROVIDER=""
BEANFX_ASR_ENDPOINT=""
BEANFX_ASR_MODEL=""

# ---------------------------------------------------------------------------
# Semantic analysis provider (RIISHE inference support).
# Values are read by src/lib/riishe-inference.ts; leave empty to use defaults.
# ---------------------------------------------------------------------------
BEANFX_SEMANTIC_PROVIDER=""
BEANFX_SEMANTIC_ENDPOINT=""
BEANFX_SEMANTIC_MODEL=""
