# BEAN FX — example environment configuration.
# Copy to .env and adjust for your machine. NEVER commit a real .env.

# ---------------------------------------------------------------------------
# SQLite database location (Prisma).
#   - Relative paths resolve against the project working directory.
#   - Absolute paths (Windows e.g. D:\BeanFX Data\db\custom.db) are supported.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./db/custom.db"

# ---------------------------------------------------------------------------
# ASR (speech-to-text) provider used for transcription.
# Values are read by src/lib/asr-providers.ts; leave empty to use defaults.
# ---------------------------------------------------------------------------
BEANFX_ASR_PROVIDER=""
BEANFX_ASR_ENDPOINT=""
BEANFX_ASR_MODEL=""

# ---------------------------------------------------------------------------
# Semantic analysis provider (RIISHE inference support).
# Values are read by src/lib/riishe-inference.ts; leave empty to use defaults.
# ---------------------------------------------------------------------------
BEANFX_SEMANTIC_PROVIDER=""
BEANFX_SEMANTIC_ENDPOINT=""
BEANFX_SEMANTIC_MODEL=""

# ---------------------------------------------------------------------------
# M19 §19 — production additions. Full inventory: docs/M19_ENVIRONMENT_VARIABLES.md
# Placeholders only — never commit real secrets.
# ---------------------------------------------------------------------------

# Public (safe to expose): canonical origin + support address.
PUBLIC_APP_URL="https://your-domain.example"
NEXT_PUBLIC_SUPPORT_EMAIL="support@your-domain.example"

# Email (optional — verification/reset flows report delivered:false when unset).
SMTP_URL=""
MAIL_FROM="BEAN FX <no-reply@your-domain.example>"
SUPPORT_EMAIL=""

# Rate limiting: MUST be 1 in production; raise only for tests/dev.
RATE_LIMIT_SCALE="1"
# Optional shared store for multi-instance deployments:
# RATE_LIMIT_REDIS_URL="redis://host:6379/0"

# Per-user upload quota (bytes). Example 20 GB:
USER_STORAGE_QUOTA_BYTES="21474836480"

# AI providers (server-only — never NEXT_PUBLIC).
BEANFX_ZAI_BIN="/usr/local/bin/z-ai"
BEANFX_MYAI_PROVIDER="zai"
BEANFX_VISUAL_PROVIDER="zai"
BEANFX_JAZMII_PROVIDER="zai"
BEANFX_LAXII_PROVIDER="zai"
