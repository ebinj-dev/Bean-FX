generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  /// M19: "user" | "admin" — server-side role checks only, never a client claim.
  role          String    @default("user")
  /// M19: set true only after the user verifies through the email-verification flow.
  emailVerified Boolean   @default(false)
  /// M19 soft-delete marker: deleted accounts are locked out; cleanup is deferred.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions     Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  projects     Project[]
  /// M30 collaboration relations.
  workspacesOwned       Workspace[]         @relation("WorkspaceOwner")
  workspaceMemberships  WorkspaceMember[]
  invitationsSent       Invitation[]        @relation("InvitationInviter")
  notifications         Notification[]
  reviewAssignments     ReviewAssignment[]
  reviewComments        ReviewComment[]
  reviewRevisionsCreated ReviewRevision[]   @relation("ReviewRevisionCreator")
  reviewLinksCreated    ReviewLink[]        @relation("ReviewLinkCreator")
  projectSharesGranted  ProjectShare[]      @relation("ProjectShareGranter")
  projectSharesReceived ProjectShare[]      @relation("ProjectShareGrantee")
  mediaAssets  MediaAsset[]
  projectArchives ProjectArchive[] @relation("ProjectArchives")
  exportFiles  ExportFile[]
  jobs         Job[]
  wordsToRemove WordsToRemove[]
  uploadSessions UploadSession[]
  cutDecisions CutDecision[]
  gangziiProcesses GangziiProcess[]
  conversations Conversation[] @relation("Conversations")
  aiPlans       AIPlan[]       @relation("AIPlans")
  automationTokens AutomationToken[] @relation("AutomationToken")
  integrationTokens IntegrationToken[]
  mcpApprovals      McpApproval[]
  automationAudits AutomationAudit[] @relation("AutomationAudit")
  aiUsage       AIUsage[]      @relation("AIUsage")
  subscription  Subscription?
  billingEvents BillingEvent[]
  creativePresets CreativePreset[]
  workflowRuns    WorkflowRun[]  @relation("WorkflowRuns")
  productions     Production[]   @relation("Productions")
  mediaMasks    MediaMask[]    @relation("MediaMasks")
  studioPlans   StudioPlan[]   @relation("StudioPlans")
  studioScenes  StudioScene[]  @relation("StudioScenes")
  studioBatches StudioBatch[]  @relation("StudioBatches")
  brandPresets      BrandPreset[]      @relation("BrandPresets")
  thumbnailDrafts   ThumbnailDraft[]   @relation("ThumbnailDrafts")
  publishMetadata   PublishMetadata[]  @relation("PublishMetadata")
  exportVariants    ExportVariant[]    @relation("ExportVariants")
  publishPackages   PublishPackage[]   @relation("PublishPackages")
  creativeReviews   CreativeReview[]   @relation("CreativeReviews")
  creativeVariants  CreativeVariant[]  @relation("CreativeVariants")
  creativeArtifacts CreativeAnalysisArtifact[] @relation("CreativeArtifacts")
  transcriptVersions TranscriptVersion[] @relation("TranscriptVersions")
}

/// User-defined words/phrases RIISHE should consider removing (context-aware —
/// a preference, never an automatic cut). Unique per user, case preserved
/// (matching is case-insensitive at analysis time).
model WordsToRemove {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phrase    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phrase])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Project settings for the editor (fps, resolution, sample rate …) —
  /// additive JSON blob; absent = sensible defaults (30fps 1080p 48kHz).
  settingsJson String?
  /// M30: null = personal project owned solely by `userId` (today's model).
  /// Set = the project is shared into a team workspace; access then follows
  /// the workspace membership role plus explicit per-user project shares.
  workspaceId String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  mediaAssets      MediaAsset[]
  projectArchives ProjectArchive[] @relation("ProjectArchives")
  timelineVersions TimelineVersion[]
  conversations Conversation[] @relation("Conversations")
  aiPlans       AIPlan[]       @relation("AIPlans")
  studioPlans StudioPlan[] @relation("StudioPlan")
  thumbnailDrafts ThumbnailDraft[] @relation("ThumbnailDrafts")
  publishMetadataRows PublishMetadata[] @relation("PublishMetadataRows")
  exportVariants ExportVariant[] @relation("ExportVariants")
  workflowRuns   WorkflowRun[]  @relation("WorkflowRuns")
  productions    Production[]   @relation("Productions")
  publishPackages PublishPackage[] @relation("PublishPackages")
  creativeReviews CreativeReview[] @relation("CreativeReviews")
  creativeVariants CreativeVariant[] @relation("CreativeVariants")
  creativeArtifacts CreativeAnalysisArtifact[] @relation("CreativeArtifacts")
  transcriptVersions TranscriptVersion[] @relation("TranscriptVersions")
  /// M30 collaboration.
  projectShares      ProjectShare[]
  reviewRevisions    ReviewRevision[]
}

model MediaAsset {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  originalName String
  storagePath  String
  kind         String // AUDIO | VIDEO
  mimeType     String
  sizeBytes    Int
  durationSec  Float?
  width        Int?
  height       Int?
  fps          Float?
  videoCodec   String?
  audioCodec   String?
  sampleRate   Int?
  channels     Int?
  role         String? // BROLL when used as b-roll library asset
  notes        String?
  createdAt    DateTime     @default(now())
  exportFiles  ExportFile[]

  // ── M3 media pipeline (all additive, backfilled to NULL for legacy rows) ──
  /// Content hash of the original file (hex sha256) — dedup + integrity.
  sha256          String?
  /// PENDING | PROCESSING | READY | FAILED — deep ffprobe runs in the worker,
  /// never in the upload request. NULL = legacy asset or SUBTITLE.
  probeStatus     String?
  probeError      String?
  /// Full ffprobe format+streams summary (trimmed JSON) from the deep probe.
  probeMetaJson   String?
  /// True when r_frame_rate and avg_frame_rate diverge (variable frame rate).
  isVfr           Boolean?
  /// Display-matrix rotation in degrees (0 = unrotated).
  rotation        Int?
  /// ffprobe display_aspect_ratio (e.g. "16:9").
  aspectRatio     String?
  /// Video stream time_base (e.g. "1/90000").
  timeBase        String?
  /// ffprobe format_name (e.g. "mov,mp4,m4a,3gp,3g2,mj2").
  formatName      String?
  /// Overall bit rate in bits/s.
  bitRate         Int?
  /// NONE | QUEUED | PROCESSING | READY | FAILED | UNSUPPORTED — editing
  /// proxies live in media-store/proxies; exports always use the original.
  proxyStatus       String?
  proxyPath         String?
  proxySizeBytes    Int?
  proxyDurationSec  Float?
  proxyError        String?

  // ── M5 GANGZII (additive; NULL = original or legacy asset) ──
  /// Set when this asset is a GANGZII-processed DERIVED copy of another
  /// asset. Originals are never modified; reprocessing always starts from
  /// the referenced original.
  derivedFromId String?
  /// GANGZII operations whose source is this asset.
  gangziiSource GangziiProcess[] @relation("GangziiSource")

  // ── M7 JAZMII/LAXII provenance (additive; NULL = upload or legacy asset) ──
  /// How this asset came into being: UPLOAD | JAZMII | LAXII. NULL = legacy.
  createdBy String?
  /// AI provider that produced the asset (e.g. "zai-image", "zai-video").
  provider String?
  /// Provider model identifier (e.g. "cogvideox-3").
  model String?
  /// Generation prompt (JAZMII/LAXII) — provenance record, not UI state.
  prompt String?
  /// Structured generation parameters (size, fps, duration, quality…).
  paramsJson String?
  /// License key resolved through the provider metadata registry.
  license String?
  /// Attribution string built from provider metadata + prompt provenance.
  attribution String?
  /// Reference asset (image-to-image, variations) — provenance, NOT a
  /// derived-copy link: the output is new content guided by the reference.
  referenceAssetId String?

  @@index([userId, sha256])
  @@index([derivedFromId])
  @@index([userId, createdBy])
  @@index([referenceAssetId])
}

/// GANGZII audio operation (M5): a persisted processing profile (params as
/// structured data) with its status and, on success, the DERIVED asset it
/// produced plus the structured inspection of the source. Original media is
/// never modified; bypass/comparison keeps referencing the original asset.
model GangziiProcess {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAssetId  String
  sourceAsset    MediaAsset @relation("GangziiSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  /// User-facing label (e.g. preset name) — optional.
  name           String?
  /// ANALYSIS | PROCESS
  kind           String
  /// QUEUED | PROCESSING | COMPLETED | FAILED | CANCELLED
  status         String
  /// Validated GangziiParams JSON (PROCESS rows).
  paramsJson     String?
  /// Validated GangziiInspection JSON (ANALYSIS rows, or the inspection
  /// backing a PROCESS decision).
  analysisJson   String?
  /// Derived MediaAsset id on PROCESS success.
  resultAssetId  String?
  /// ffprobe summary of the derived file + processing notes/warnings JSON.
  resultMetaJson String?
  error          String?
  /// Durable Job row driving the work (polling + cancellation entry point).
  jobId          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId, sourceAssetId])
  @@index([status])
}

model ExportFile {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId     String?
  media       MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  kind        String // AUDIO | VIDEO | CAPTIONS | PLAN
  format      String
  filename    String
  storagePath String
  sizeBytes   Int
  durationSec Float?
  paramsJson  String?
  createdAt   DateTime    @default(now())
  /// M30: review revisions whose preview was produced by this export.
  reviewRevisions ReviewRevision[] @relation("ReviewRevisionPreview")
}

model Job {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // AUDIO_PROCESS | AUTOCUT_APPLY | WATERMARK | BURN_CAPTIONS | MEDIA_PROBE | MEDIA_PROXY
  status     String // QUEUED | PROCESSING | COMPLETED | FAILED | CANCELLED
  progress   Int      @default(0)
  stage      String?
  message    String?
  paramsJson String?
  exportId   String?

  // ── M3 worker fields (additive; legacy job types ignore them) ──
  /// Completed claim attempts. One attempt = one claim; retries re-queue with backoff.
  attempts        Int      @default(0)
  /// Maximum claims before the job is FAILED permanently.
  maxAttempts     Int      @default(3)
  /// Earliest time the worker may claim this job (retry backoff).
  runAfter        DateTime?
  /// Worker liveness marker — stale heartbeats trigger recovery.
  lastHeartbeatAt DateTime?
  /// When the current claim started (lease start, for stale-claim detection).
  claimedAt       DateTime?
  /// Hard wall-clock limit for this job's handler (seconds).
  timeoutSec      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cutDecisions CutDecision[]
}

/// Per-candidate decision (APPROVE | REJECT | KEEP) of one Auto Cut analysis.
/// One row per (user, analysis job, candidate); re-deciding converges on the
/// same row. Writes are validated against the immutable analysis result.
model CutDecision {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidateId String
  decision    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@unique([userId, jobId, candidateId])
}

/// Append-only history of every decision write, so previous decisions are
/// preserved, never overwritten (no foreign keys, matching the migration DDL).
model CutDecisionEvent {
  id          String   @id @default(cuid())
  userId      String
  jobId       String
  candidateId String
  decision    String
  createdAt   DateTime @default(now())

  @@index([jobId, candidateId])
}

/// Immutable snapshot of the editor timeline at one point. Versions are
/// append-only: an edit batch always creates the next version, never updates
/// or deletes an existing one (rollback = a new version from an old snapshot).
model TimelineVersion {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  sequenceJson  String
  isAutosave    Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  edits         TimelineEdit[]
  reviewRevisions ReviewRevision[]

  @@unique([projectId, versionNumber])
  @@index([projectId, createdAt])
}

/// Per-command audit trail for one version: what was applied and the exact
/// inverse commands (undo evidence). Immutable, like the snapshot.
model TimelineEdit {
  id          String          @id @default(cuid())
  versionId   String
  version     TimelineVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  opIndex     Int
  type        String
  payloadJson String
  inverseJson String
  createdAt   DateTime        @default(now())

  @@index([versionId, opIndex])
}

/// Server-side bookkeeping for one resumable chunked upload (M3). Chunks land
/// in media-store/tmp/up_{id}/ as per-index part files; the row tracks what
/// arrived so a client can resume after any interruption. Abandoned sessions
/// are swept (scratch removed) — assembled originals are never touched.
model UploadSession {
  id            String   @id // client-generated upload id (hex), shared by all chunks
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName  String
  ext           String
  kind          String // VIDEO | AUDIO | SUBTITLE (from extension allowlist)
  declaredSize  BigInt // client-declared total byte count
  chunkSize     Int
  chunkTotal    Int
  receivedCount Int      @default(0)
  /// OPEN | COMPLETED | FAILED | CANCELLED
  status        String   @default("OPEN")
  /// Optional client-declared checksum, verified against the assembled bytes.
  sha256        String?
  mediaAssetId  String? // set when the session produced an asset
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastChunkAt   DateTime @default(now())

  @@index([userId, status])
  @@index([lastChunkAt])
}

/// ── M8 MY AI orchestration ─────────────────────────────────────────────────
/// Project-scoped assistant conversation (§11): user-owned, deletable, never
/// cross-user. Messages hold bounded text/tool summaries — no private media.
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("Conversations", fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation("Conversations", fields: [projectId], references: [id], onDelete: Cascade)
  title       String   @default("Conversation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    ConversationMessage[]
  plans       AIPlan[]

  @@index([userId, projectId, updatedAt])
}

/// One assistant/user/tool turn. role: user | assistant | tool | system.
model ConversationMessage {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  /// Bounded structured attachments (tool summaries, plan refs) — never media.
  metaJson       String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// A versioned editing plan (§6). status: DRAFT | VALIDATING | AWAITING_APPROVAL
/// | APPROVED | QUEUED | RUNNING | PARTIALLY_COMPLETED | COMPLETED | FAILED
/// | CANCELLED | EXPIRED. stepsJson holds the validated plan; resultsJson the
/// per-step outcomes (partial failure is recorded accurately).
model AIPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("AIPlans", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation("AIPlans", fields: [projectId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  schemaVersion  Int      @default(1)
  status         String   @default("DRAFT")
  requestSummary String  
  stepsJson      String  
  contextVersion String?
  plannerMode    String   @default("deterministic") // llm | deterministic-fallback
  engines        String?
  warningsJson   String?
  resultJson     String?
  idempotencyKey String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, projectId, status, updatedAt])
}

/// Automation credentials for MCP / JSON-RPC clients (§9B). The raw token is
/// shown ONCE at creation; only the SHA-256 hash is stored.
model AutomationToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("AutomationToken", fields: [userId], references: [id], onDelete: Cascade)
  name         String
  tokenHash    String    @unique
  prefix       String
  /// read-only | editing — editing includes every read-only capability.
  profile      String    @default("read-only")
  /// Optional tool allowlist (JSON array of tool names; empty = all in profile).
  allowlistJson String?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
}

/// Audit history for every automation/API/MY AI mutation (§9B/§13).
model AutomationAudit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("AutomationAudit", fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  action     String
  detailJson String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

/// LLM usage accounting (§4/§13): token counts reported by the provider.
model AIUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("AIUsage", fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  model            String
  purpose          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int?
  ok               Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

/// ── M8.1 Social Video Studio ───────────────────────────────────────────────
/// A topic-to-video production plan (M8.1 §3). briefJson holds the validated
/// Brief; planJson the typed ProductionPlan (scenes, script, hook, CTA…).
/// status: DRAFT | PLANNING | SCENES_READY | ASSEMBLED | FAILED | CANCELLED.
model StudioPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("StudioPlans", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation("StudioPlan", fields: [projectId], references: [id], onDelete: SetNull)
  /// DRAFT (brief saved) | PLANNING | SCENES_READY | ASSEMBLED | FAILED | CANCELLED
  status         String   @default("DRAFT")
  briefJson      String
  planJson       String?
  plannerMode    String   @default("deterministic-fallback")
  sceneCount     Int      @default(0)
  /// Assembly metadata: per-scene clip ids, caption provenance, notes.
  assemblyJson   String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  scenes         StudioScene[]

  @@index([userId, updatedAt])
  @@index([projectId])
}

/// One scene of a production plan — individually editable/regenerable (§4).
/// assetSource: none | jazmii | laxii | upload | narration-image
/// status: EMPTY | ASSET_PENDING | ASSET_READY | NARRATION_READY | READY
model StudioScene {
  id                String   @id @default(cuid())
  planId            String
  plan              StudioPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation("StudioScenes", fields: [userId], references: [id], onDelete: Cascade)
  sceneNumber       Int
  durationSec       Int
  narration         String   @default("")
  visualDescription String   @default("")
  footageNeed       String   @default("")
  brollNote         String   @default("")
  onScreenText      String   @default("")
  captionText       String   @default("")
  audioNote         String   @default("")
  transition        String   @default("CUT")
  assetId           String?
  assetKind         String? // VIDEO | IMAGE
  assetSource       String   @default("none")
  attributionJson   String?
  narrationAssetId  String?
  status            String   @default("EMPTY")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([planId, sceneNumber])
  @@index([planId, sceneNumber])
}

/// Batch topic production (§11) — dispatches per-topic STUDIO_TOPIC durable
/// jobs through the EXISTING job infrastructure (no new queue).
model StudioBatch {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("StudioBatches", fields: [userId], references: [id], onDelete: Cascade)
  status            String   @default("RUNNING") // RUNNING | COMPLETED | CANCELLED
  briefJson         String
  topicsJson        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

/// ── M9 Professional Publishing ─────────────────────────────────────────────
/// Reusable creator brand preset (§5 of the M9 spec). Colours are hex RGB;
/// asset references are owned MediaAsset ids. Applying a preset to a project
/// is ADDITIVE-merge only — keys the preset does not own are never touched.
model BrandPreset {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("BrandPresets", fields: [userId], references: [id], onDelete: Cascade)
  name             String
  /// Display brand name used in metadata/thumbnail text suggestions.
  brandName        String   @default("")
  logoAssetId      String?
  watermarkAssetId String?
  /// Hex RGB (#rrggbb).
  primaryColor     String   @default("#d4a017")
  secondaryColor   String   @default("#111111")
  /// Typography selection key from the preset registry (e.g. "inter", "nikki-tamil").
  fontFamily       String   @default("inter")
  /// Caption styling config (validated shape at the API boundary).
  captionStyleJson String?
  introAssetId     String?
  outroAssetId     String?
  /// Thumbnail styling preferences (overlay defaults for the Thumbnail Studio).
  thumbnailStyleJson String?
  /// Default export profile id (validated against the profile registry).
  defaultExportProfile String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Thumbnail workspace for one project+platform (§3): generated candidates are
/// MediaAssets (LAXII provenance preserved); selection and the editable title
/// overlay are config, never in-place edits. Composite outputs are NEW assets —
/// regeneration never overwrites a previous selection.
model ThumbnailDraft {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("ThumbnailDrafts", fields: [userId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project  @relation("ThumbnailDrafts", fields: [projectId], references: [id], onDelete: Cascade)
  platform          String
  /// DRAFT | GENERATING | READY | FAILED
  status            String   @default("DRAFT")
  /// User hint / custom prompt for LAXII generation.
  prompt            String   @default("")
  /// Editable title overlay: text, position, style (validated shape).
  layoutJson        String?
  /// Ordered generated candidate MediaAsset ids.
  candidateIdsJson  String?
  /// Currently selected base image (a candidate or an OWNED uploaded asset).
  selectedAssetId   String?
  /// Latest composited output asset (base + overlay) — new row per apply.
  compositedAssetId String?
  provenanceJson    String?
  error             String?
  jobId             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, platform])
  @@index([userId, updatedAt])
}

/// AI-generated publishing metadata for one project+platform (§4). draftJson
/// holds the AI SUGGESTIONS (with per-field provider provenance); approvedJson
/// holds USER-APPROVED values — the two are never conflated.
model PublishMetadata {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("PublishMetadata", fields: [userId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project  @relation("PublishMetadataRows", fields: [projectId], references: [id], onDelete: Cascade)
  platform         String
  language         String   @default("en") // en | ta
  /// DRAFT | GENERATED | APPROVED
  status           String   @default("DRAFT")
  draftJson        String?
  approvedJson     String?
  provider         String?
  model            String?
  /// Bounded history of per-field regenerations (audit trail).
  fieldHistoryJson String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, platform])
  @@index([userId, updatedAt])
}

/// One multi-platform export variant (§6): a validated profile + durable job
/// on the EXISTING M3 worker transcoding a master source through the existing
/// FFmpeg path. profileJson records the EXACT profile used (audit evidence).
model ExportVariant {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("ExportVariants", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation("ExportVariants", fields: [projectId], references: [id], onDelete: SetNull)
  profileId      String
  profileVersion String
  profileJson    String
  /// QUEUED | RENDERING | COMPLETED | FAILED | CANCELLED
  status         String   @default("QUEUED")
  progress       Int      @default(0)
  stage          String?
  /// Master source: a completed ExportFile (render) or an owned MediaAsset.
  sourceExportId String?
  sourceAssetId  String?
  /// Completed output (ExportFile, kind VIDEO) on success.
  resultExportId String?
  /// ffprobe-based conformance report of the produced file.
  validationJson String?
  settingsJson   String?
  error          String?
  attempts       Int      @default(0)
  jobId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([projectId, status])
}

/// Publication-ready package (§7): deterministic manifest + zip of APPROVED
/// metadata, selected thumbnail and COMPLETED variant outputs only — never
/// private source media or unrelated assets.
model PublishPackage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("PublishPackages", fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation("PublishPackages", fields: [projectId], references: [id], onDelete: SetNull)
  /// BUILDING | READY | FAILED
  status           String   @default("BUILDING")
  variantIdsJson   String
  metadataId       String?
  thumbnailDraftId String?
  /// Deterministic manifest (sorted keys, recorded sha256 per entry).
  manifestJson     String?
  manifestSha256   String?
  /// The downloadable zip (packages/<id>.zip).
  storagePath      String?
  sizeBytes        Int?
  error            String?
  jobId            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
}

/// ── M10 AI Creative Director & Content Intelligence ────────────────────────
/// One creative analysis run over a project. contextVersion captures the
/// timeline head using the SAME staleness formula MY AI uses
/// (v:<version>:<clipCount>:<maxEnd>) so stale reviews are detectable.
model CreativeReview {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation("CreativeReviews", fields: [userId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project  @relation("CreativeReviews", fields: [projectId], references: [id], onDelete: Cascade)
  /// full | retention | scorecard | brief
  scope               String   @default("full")
  language            String   @default("en") // en | ta
  /// QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  status              String   @default("QUEUED")
  progress            Int      @default(0)
  stage               String?
  /// Timeline version the analysis was computed against (staleness check).
  contextVersion      String
  headVersion         Int
  /// Structured creative brief (observed vs AI-interpreted, evidence refs).
  briefJson           String?
  /// What was NOT inspected (honest partial analysis).
  missingEvidenceJson String?
  /// Which engines provided which evidence (e.g. GANGZII inspection job id).
  evidenceSourcesJson String?
  /// LLM model used for interpretive parts (null = deterministic only).
  provider            String?
  model               String?
  error               String?
  jobId               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  findings         CreativeFinding[]
  recommendations  CreativeRecommendation[]
  scorecard        CreativeScorecard?

  @@index([userId, projectId, createdAt])
}

/// One evidence-based finding from a review. evidenceLabel separates MEASURED
/// facts from inferred/AI interpretation/insufficient evidence (§4 honesty).
model CreativeFinding {
  id            String  @id @default(cuid())
  reviewId      String
  review        CreativeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  findingNo     Int
  /// opening-hook | long-pause | dead-air | pacing | caption-timing |
  /// repeated-narration | audio-quality | transition | ending-cta |
  /// scene-structure | visual-repetition | technical | narrative
  category      String
  startSec      Float?
  endSec        Float?
  /// info | minor | moderate | major
  severity      String  @default("info")
  /// 0..1 where quantifiable; null when not.
  confidence    Float?
  /// measured | inferred | ai-interpretation | insufficient-evidence
  evidenceLabel String
  /// The actual measured values + source references (engine, job, asset).
  evidenceJson  String
  explanation   String
  suggestion    String?
  /// RIISHE | GANGZII | NIIKI | JAZMII | LAXII | MYAI | deterministic
  engine        String  @default("deterministic")

  @@index([reviewId])
}

/// A typed, executable-or-informational improvement proposal (§5). Executable
/// proposals carry M1 commands and are applied ONLY after explicit approval,
/// through the versioned persistence path (undo/redo/autosave intact). Stale
/// proposals are rejected when the timeline head has moved.
model CreativeRecommendation {
  id                        String   @id @default(cuid())
  reviewId                  String
  review                    CreativeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId                    String
  projectId                 String
  recNo                     Int
  /// informational | executable
  kind                      String
  engine                    String
  title                     String
  detail                    String
  /// Target range/reference: { clipId?, trackId?, startSec?, endSec? }.
  targetJson                String?
  /// Typed proposal payload: { commands: Command[] } or engineAction spec.
  proposalJson              String
  /// Human-readable preview of what applying would do.
  previewJson               String?
  requiresApproval          Boolean  @default(true)
  /// PROPOSED | APPROVED | REJECTED | EXECUTED | FAILED | STALE
  status                    String   @default("PROPOSED")
  timelineVersionAtProposal Int
  executedVersion           Int?
  resultJson                String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([reviewId])
  @@index([userId, projectId, status])
}

/// A/B Studio variant (§6): a creative alternative preserved alongside the
/// original. Applied variants record the decision; no performance claims are
/// made without real experimental data (labelled creative evaluation).
model CreativeVariant {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation("CreativeVariants", fields: [userId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project  @relation("CreativeVariants", fields: [projectId], references: [id], onDelete: Cascade)
  reviewId           String?
  /// hook | narration-section | thumbnail | title | description | cta | scene-sequence
  kind               String
  label              String
  description        String
  /// Which elements changed (e.g. ["first-8-seconds narration"]).
  changedElementsJson String?
  /// Text payload / LAXII assetId / M1 command batch for scene-sequence.
  payloadJson        String
  provenanceJson     String
  /// PROPOSED | SELECTED | DISCARDED | APPLIED
  status             String   @default("PROPOSED")
  comparisonJson     String?
  decisionNote       String?
  appliedVersion     Int?
  appliedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, projectId, kind])
}

/// ── M11 Multimodal Intelligence ────────────────────────────────────────────
model CreativeAnalysisArtifact {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("CreativeArtifacts", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation("CreativeArtifacts", fields: [projectId], references: [id], onDelete: Cascade)
  kind           String
  sourceAssetId  String?
  streamIndex    Int?
  status         String   @default("QUEUED")
  depsJson       String
  depsHash       String
  staleReason    String?
  resultJson     String?
  missingEvidenceJson String?
  provider       String?
  model          String?
  consentVisual  Boolean  @default(false)
  error          String?
  jobId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, projectId, kind, depsHash])
  @@index([projectId, sourceAssetId])
}

model TranscriptVersion {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("TranscriptVersions", fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation("TranscriptVersions", fields: [projectId], references: [id], onDelete: Cascade)
  sourceAssetId  String
  streamIndex    Int?
  versionNo      Int
  language       String
  provider       String?
  model          String?
  text           String
  segmentsJson   String
  wordsAvailable Boolean  @default(false)
  warningsJson   String?
  status         String   @default("PENDING_REVIEW")
  depsJson       String
  depsHash       String
  staleReason    String?
  captionAssetId String?
  jobId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, sourceAssetId, versionNo])
  @@index([projectId, status])
}

/// Explainable scorecard (§7) — one per review. dimensionsJson holds the 8
/// dimensions (score/evidence/explanation/confidence/missingData/suggestions)
/// under a documented, versioned scoring model. Missing data → null score.
model CreativeScorecard {
  id           String   @id @default(cuid())
  reviewId     String   @unique
  review       CreativeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  modelVersion String
  dimensionsJson String
  overallNote  String?
  createdAt    DateTime @default(now())
}

// ── M14 — AI Art Direction & Motion Composition ─────────────────────────────
/// Approved art direction (§4). payloadJson = the full typed direction (name,
/// rationale, palette with provenance, typography, motion language, style
/// profile...). status: PROPOSED (one of a 3-candidate comparison) → APPROVED
/// (creator-approved; assets/composition may derive from it) → DISCARDED.
/// fingerprint prevents direction homogenization across proposals.
model ArtDirection {
  id           String   @id @default(cuid())
  userId       String
  projectId    String
  name         String
  status       String   @default("PROPOSED")
  payloadJson  String
  fingerprint  String
  batchId      String?
  provider     String?
  model        String?
  consentVisual Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, projectId, status])
  @@index([projectId, batchId])
}

/// Narration-aware scene plan (§5) — the single structured source shared by
/// art direction, asset generation, composition and motion. scenesJson holds
/// the typed scene array (stable ids, RIISHE segment refs, VERBATIM
/// timestamps, estimated flags, approval status per scene, assets, motion).
model ScenePlan {
  id             String   @id @default(cuid())
  userId         String
  projectId      String
  artDirectionId String?
  language       String   @default("en")
  version        Int      @default(1)
  scenesJson     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, projectId])
}

/// Versioned composition document (§8) — additive, non-destructive.
/// docJson = canonical composition (canvas, layers with transforms/masks/
/// blend, track bindings). Every approved edit writes a new CompositionVersion
/// row (M1 timeline versioning pattern): undo/redo and reopen by version.
model Composition {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  name      String
  width     Int
  height    Int
  fps       Int
  docJson   String
  version   Int      @default(1)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  CompositionVersion[]

  @@unique([projectId, name])
  @@index([userId, projectId])
}

model CompositionVersion {
  id           String      @id @default(cuid())
  composition  Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  compositionId String
  version      Int
  docJson      String
  note         String?
  createdAt    DateTime    @default(now())

  @@unique([compositionId, version])
  @@index([compositionId, version])
}

/// M19: single-use email-verification tokens (SHA-256 hashed at rest).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

/// M19: single-use password-reset tokens (SHA-256 hashed at rest, consumed on use).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

/// M19: privileged-action audit trail (deletions, admin actions, security events).
model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([action])
}

/// M21 P2 — integration tokens for API v1 (Desktop Bridge, MCP agents,
/// Premiere panel). Only the SHA-256 hash is stored; the raw `bfx_…` token
/// is shown exactly once at creation. Scopes can only NARROW what the
/// owning user may do (never widen).
model IntegrationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// sha256(raw token) hex — timing-safe compared, never reversible.
  tokenHash  String    @unique
  /// Display prefix (first 12 chars, e.g. "bfx_9f2c1a77") for UI lists.
  tokenPrefix String
  /// JSON array of TokenScope strings (see src/lib/core/types.ts).
  scopes     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?
}

/// M21 P4 — one-time, hash-bound approval for a MCP mutation (external
/// agents can never mutate without a human-approved record created through
/// the authenticated web session). Consumed exactly once; payload hash must
/// match the tool-call arguments or the call is rejected.
model McpApproval {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  payloadHash String
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?
  consumedBy  String?
  expiresAt   DateTime
  @@index([userId, action])
}

/// M25 P2 — billing & subscription foundation. Payments are DISABLED by
/// design: no provider, no prices, no checkout. Paid plans activate only via
/// admin manual assignment (audited) until the owner authorizes payments.
model SubscriptionPlan {
  id               String         @id // "free" | "creator" | "studio"
  name             String
  sort             Int            @default(0)
  /// JSON entitlements: limits (null = unlimited), feature flags, requiresPayment, selfServe.
  entitlementsJson String
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  subscriptions    Subscription[]
}

model Subscription {
  id                 String           @id @default(cuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  /// ACTIVE | ENDED (downgraded after a cancelled period rolled over)
  status             String           @default("ACTIVE")
  cancelAtPeriodEnd  Boolean          @default(false)
  /// payments disabled → always "none"; a real provider is an owner action.
  provider           String           @default("none")
  currentPeriodStart DateTime          @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  events             BillingEvent[]
  @@index([status])
}

model BillingEvent {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SUBSCRIPTION_ACTIVATED | PLAN_ASSIGNED | PLAN_CHANGED_SELF_SERVE |
  /// PAYMENTS_DISABLED_BLOCK | CANCEL_SCHEDULED | CANCEL_RESUMED |
  /// SUBSCRIPTION_ENDED | PERIOD_RENEWED | ADMIN_OVERRIDE
  type       String
  detailJson String?
  createdAt  DateTime     @default(now())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

/// M26 P4 — reusable creative presets (per user, per kind). Payloads hold
/// engine-shaped data (effect stacks, caption styles, export profile sets,
/// GANGZII processing params) — version-tagged for forward compatibility.
model CreativePreset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// VIDEO_EFFECT | CAPTION | AUDIO | EXPORT
  kind        String
  name        String
  /// Kind-shaped payload (JSON). v1 contracts documented in the API routes.
  payloadJson String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([userId, kind, name])
  @@index([userId, kind])
}

/// M26 P7 — workflow automation runs. Definitions come ONLY from the
/// server-side whitelisted template library (no arbitrary code); each step
/// records its durable runtime state (dispatched job id, approval state).
model WorkflowRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("WorkflowRuns", fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation("WorkflowRuns", fields: [projectId], references: [id], onDelete: SetNull)
  templateId String
  name       String
  /// PENDING | RUNNING | AWAITING_APPROVAL | COMPLETED | FAILED | CANCELLED
  status     String   @default("PENDING")
  /// Ordered steps: [{ id, kind, params, status, jobId?, stepError?, approvalRequired?, approved? }]
  stepsJson  String
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([userId, status])
  @@index([projectId])
}

/// M29 — project portability archives. One row per packaging/import attempt;
/// the file lives in storage under project-archives/. Modes: FULL (originals +
/// proxies), NO_PROXIES (originals only), METADATA (manifest + project JSON,
/// external media). Status lifecycle: QUEUED → BUILDING → COMPLETED / FAILED /
/// CANCELLED — the durable Job table drives the work (no second queue).
model ProjectArchive {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("ProjectArchives", fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation("ProjectArchives", fields: [projectId], references: [id], onDelete: SetNull)
  mode          String   @default("FULL")
  /// ARCHIVE (export) or IMPORT (restore from an uploaded package).
  direction     String   @default("ARCHIVE")
  status        String   @default("QUEUED")
  formatVersion String
  schemaVersion String
  manifestJson  String?
  storagePath   String?
  sizeBytes     Int?
  assetCount    Int?
  progress      Int      @default(0)
  stage         String?
  error         String?
  jobId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// M30 — COLLABORATIVE WORKSPACES, CLIENT REVIEW & APPROVAL
/// Additive models. Server-side permission matrix lives in src/lib/collab.ts.
/// ─────────────────────────────────────────────────────────────────────────

/// M30: a team workspace. Personal usage (no workspace) is unchanged.
model Workspace {
  id          String   @id @default(cuid())
  name        String
  ownerUserId String
  owner       User     @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     WorkspaceMember[]
  invitations Invitation[]
  projects    Project[]
  @@index([ownerUserId])
}

/// M30: workspace membership with the server-enforced role.
/// OWNER cannot be removed or demoted (guard rails in collab.ts).
model WorkspaceMember {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "OWNER" | "ADMIN" | "EDITOR" | "REVIEWER" | "VIEWER"
  role        String
  createdById String
  createdAt   DateTime    @default(now())
  @@unique([workspaceId, userId])
  @@index([userId])
}

/// M30: workspace invitation. Raw token is NEVER stored — SHA-256 hash only
/// (same hygiene as EmailVerificationToken). The raw token is shown once and
/// embedded in a copyable invite URL; email delivery is best-effort via the
/// M19 mailer and honestly reported as not-configured when SMTP is absent.
model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Lower-cased email of the intended recipient — the invitation is BOUND to
  /// this identity; another account cannot accept it.
  email       String
  /// Invited role: never above the inviter's own capability.
  role        String
  tokenHash   String    @unique
  /// PENDING → ACCEPTED | REJECTED | EXPIRED | REVOKED (terminal; no reuse).
  state       String    @default("PENDING")
  expiresAt   DateTime
  invitedById String
  inviter     User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, state])
  @@index([email])
}

/// M30: explicit named-collaborator grant on ONE project (independent of any
/// workspace). Revocable; grants never widen the granter's own rights.
model ProjectShare {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("ProjectShareGrantee", fields: [userId], references: [id], onDelete: Cascade)
  /// "EDITOR" | "REVIEWER" | "VIEWER" (never OWNER — ownership is inalienable)
  role        String
  grantedById String
  granter     User      @relation("ProjectShareGranter", fields: [grantedById], references: [id], onDelete: Cascade)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  @@unique([projectId, userId])
  @@index([userId])
}

/// M30: an immutable review revision — client approval binds to THIS, never
/// to the live project. Built on the existing TimelineVersion snapshot (no
/// second version system): the revision pins versionNumber + a fingerprint of
/// the canonical sequence JSON, so later project edits cannot alter it.
model ReviewRevision {
  id                String       @id @default(cuid())
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Monotonic per project (1,2,3…).
  sessionNo         Int
  /// The pinned, immutable timeline snapshot.
  timelineVersionId String
  timelineVersion   TimelineVersion @relation(fields: [timelineVersionId], references: [id], onDelete: Cascade)
  versionNumber     Int
  /// SHA-256 over canonical revision inputs — detects any drift.
  fingerprint       String
  /// DRAFT | PROCESSING | READY_FOR_REVIEW | IN_REVIEW | CHANGES_REQUESTED
  /// | APPROVED | SUPERSEDED | CANCELLED | FAILED
  status            String       @default("PROCESSING")
  title             String
  instruction       String?
  dueAt             DateTime?
  /// "ALL" (every assigned reviewer must approve) | "ANY" (one approval wins)
  approvalPolicy    String       @default("ALL")
  createdById       String
  creator           User         @relation("ReviewRevisionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  /// The reviewable preview produced by the REAL render pipeline.
  previewExportId   String?
  previewExport     ExportFile?  @relation("ReviewRevisionPreview", fields: [previewExportId], references: [id], onDelete: SetNull)
  previewDurationSec Float?
  /// When a newer revision supersedes this one.
  supersededById    String?
  approvedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  assignments       ReviewAssignment[]
  comments          ReviewComment[]
  links             ReviewLink[]
  @@unique([projectId, sessionNo])
  @@index([projectId, createdAt])
  @@index([status])
}

/// M30: one reviewer's decision on ONE revision. Decisions are unique per
/// (revision, reviewer) — resubmission of a changed mind is a new revision.
model ReviewAssignment {
  id             String         @id @default(cuid())
  revisionId     String
  revision       ReviewRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// Null when the decision came through a review LINK (guest reviewer).
  reviewerUserId String?
  reviewer       User?          @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)
  /// Guest identity (self-reported display name bound to the link session).
  guestName      String?
  guestLinkId    String?
  guestLink      ReviewLink?    @relation("GuestDecisions", fields: [guestLinkId], references: [id], onDelete: Cascade)
  /// PENDING | APPROVED | CHANGES_REQUESTED | REJECTED | DECLINED
  state          String         @default("PENDING")
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  @@index([revisionId, reviewerUserId])
  @@index([guestLinkId])
}

/// M30: frame-accurate review comment on ONE revision. Frame identity uses
/// INTEGER frames in the sequence timebase (fps num/den persisted alongside);
/// seconds are derived for display only. Replies form one-level threads.
model ReviewComment {
  id            String         @id @default(cuid())
  revisionId    String
  revision      ReviewRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// Null for top-level comments.
  parentId      String?
  parent        ReviewComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ReviewComment[] @relation("CommentThread")
  /// Authenticated author OR a guest identified by the review link.
  authorUserId  String?
  author        User?          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  guestName     String?
  /// Integer frame number in the sequence timebase (null = general comment).
  frame         Int?
  /// Canonical fps the frame was addressed in: num/den.
  fpsNum        Int?
  fpsDen        Int?
  /// Derived display timestamp (frame / fps) — NOT the frame identity.
  timeSeconds   Float?
  clipId        String?
  body          String
  /// OPEN | RESOLVED
  status        String         @default("OPEN")
  editCount     Int            @default(0)
  editedAt      DateTime?
  createdAt     DateTime       @default(now())
  @@index([revisionId, status])
  @@index([parentId])
  @@index([authorUserId])
}

/// M30: revocable external review link for ONE revision. High-entropy token;
/// only the SHA-256 hash is stored. Guests get a scoped session (no
/// workspace membership, no edit rights, no original-media access).
model ReviewLink {
  id            String         @id @default(cuid())
  revisionId    String
  revision      ReviewRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  tokenHash     String         @unique
  /// ACTIVE | REVOKED | EXPIRED
  state         String         @default("ACTIVE")
  /// "VIEW" | "COMMENT" | "APPROVE" — comments/approval must be granted.
  permission    String         @default("COMMENT")
  expiresAt     DateTime
  /// Optional password (SHA-256 at rest, same hashToken).
  passwordHash  String?
  createdById   String
  creator       User           @relation("ReviewLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  accessCount   Int            @default(0)
  lastAccessAt  DateTime?
  createdAt     DateTime       @default(now())
  guestAccesses  GuestAccess[]
  guestDecisions ReviewAssignment[] @relation("GuestDecisions")
  @@index([revisionId, state])
}

/// M30: one guest identity bound to one link. The guest session cookie holds
/// linkId + guest token; the guest can only act within the shared revision.
model GuestAccess {
  id         String     @id @default(cuid())
  linkId     String
  link       ReviewLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// Self-reported display name (never treated as an authenticated identity).
  displayName String
  tokenHash  String     @unique
  lastSeenAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  @@index([linkId])
}

/// M30: durable in-app notification. dedupKey makes retries idempotent.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. "invitation.received", "review.requested", "comment.created",
  /// "review.approved", "review.changes_requested", "revision.superseded".
  type        String
  projectId   String?
  payloadJson String?
  /// Stable key for retry-safe creation; unique where present.
  dedupKey    String?   @unique
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// M30: render job for the review preview (ExportFile kind REVIEW_PREVIEW).
/// Completed by the existing RENDER_TIMELINE pipeline via a hook that flips
/// the revision to READY_FOR_REVIEW.

/// M31 — BEAN AI Production Studio. One row per agentic video production.
/// The pipeline engine (src/lib/production) drives stages; executable work
/// runs on the EXISTING durable Job system — never a second queue. briefJson
/// is the structured intake brief; conceptJson/scriptJson/storyboardJson hold
/// approved stage artifacts; deliveryJson lists final validated artifacts.
model Production {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation("Productions", fields: [userId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project? @relation("Productions", fields: [projectId], references: [id], onDelete: SetNull)
  templateId          String
  /// DRAFT | PLANNED | RUNNING | AWAITING_APPROVAL | COMPLETED | FAILED | CANCELLED
  status              String   @default("DRAFT")
  title               String
  briefJson           String?
  conceptJson         String?
  scriptJson          String?
  storyboardJson      String?
  researchJson        String?
  referenceJson       String?
  /// M31 SHOWCASE STUDIO: validated product-understanding artifact (Phase 1).
  productJson         String?
  deliveryJson        String?
  /// Approved budget in cents (user-set). NULL = no budget set (never treated as 0).
  approvedBudgetCents Int?
  estimatedCostCents  Int?
  actualCostCents     Int?
  pendingCostCents    Int?
  /// NOT_RUN | PASSED | PASSED_WITH_WARNINGS | FAILED | NEEDS_HUMAN_REVIEW
  qaState             String   @default("NOT_RUN")
  qaJson              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  stages              ProductionStage[]
  decisions           ProductionDecision[]
  assets              ProductionAsset[]
  events              ProductionEvent[]
  variants            ProductionVariant[] @relation("Variants")
  @@index([userId, status])
  @@index([projectId])
}

/// One pipeline stage per production; deterministic server-enforced states.
model ProductionStage {
  id            String   @id @default(cuid())
  productionId  String
  production    Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  key           String
  order         Int
  /// NOT_STARTED | READY | RUNNING | AWAITING_APPROVAL | SUCCEEDED | FAILED |
  /// CANCEL_REQUESTED | CANCELLED | SKIPPED | BLOCKED | SUPERSEDED
  state         String   @default("NOT_STARTED")
  jobId         String?
  startedAt     DateTime?
  completedAt   DateTime?
  /// Verified outputs for resume (never trust RUNNING state across restarts).
  checkpointJson String?
  outputJson    String?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([productionId, key])
  @@index([productionId, state])
}

/// Append-only decision history. A changed decision appends a new row —
/// prior decisions are never rewritten.
model ProductionDecision {
  id           String   @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  kind         String
  valueJson    String
  createdAt    DateTime @default(now())
  @@index([productionId, kind, createdAt])
}

/// Planned/generated asset with rights provenance. licenseState values:
/// VERIFIED | ATTRIBUTION_REQUIRED | USER_CONFIRMED | UNKNOWN | RESTRICTED
model ProductionAsset {
  id            String   @id @default(cuid())
  productionId  String
  production    Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  sceneKey      String?
  category      String
  description   String
  /// USER_MEDIA | GENERATION | STOCK | DETERMINISTIC | CAPTION | GRAPHIC
  sourceType    String
  provider      String?
  model         String?
  licenseState  String   @default("UNKNOWN")
  attribution   String?
  /// PLANNED | PENDING | GENERATING | READY | APPROVED | REJECTED | FAILED | BLOCKED
  status        String   @default("PLANNED")
  /// Durable Job id while GENERATING (provider work rides the existing queue).
  jobId         String?
  /// M32: client-supplied idempotency key — duplicate-submission protection
  /// (same key on the same production returns the EXISTING job, never a
  /// second paid provider call).
  idempotencyKey String?
  /// Last failure detail (honest, never fabricated).
  error         String?
  /// true when the cost is genuinely unknown — the UI shows "unknown", not 0.
  costUnknown   Boolean  @default(true)
  costCents     Int?
  storagePath   String?
  mediaAssetId  String?
  provenanceJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([productionId, status])
  @@index([productionId, sceneKey])
}

/// M32 Track C: a subject mask for real mask-based compositing. Masks are
/// versioned (parentId chain), stored as PNGs inside the media store, and
/// survive project packaging/import because they are ordinary MediaAsset-
/// adjacent rows keyed to source assets (relink = same storage layout).
model MediaMask {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("MediaMasks", fields: [userId], references: [id], onDelete: Cascade)
  /// The footage the mask belongs to (per-source association).
  sourceAssetId String
  /// PNG inside MEDIA_ROOT/media-store/masks (8-bit alpha or binary).
  storagePath   String
  width         Int
  height        Int
  /// "manual-import" | "editor-refine" | "<provider id>" (auto path)
  method        String
  version       Int      @default(1)
  /// The mask this one was refined from (version chain).
  parentId      String?
  /// UNCHECKED | VALIDATED | FAILED — validation is real (PIL decode + stats).
  validationStatus String @default("UNCHECKED")
  validationJson String?
  /// Coordinate space label, e.g. "pixel:source-resolution".
  coordSpace    String   @default("pixel:source-resolution")
  /// Temporal metadata for frame-mapped masks.
  fps           Float?
  frameIndex    Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId, sourceAssetId])
}

/// M32 Track B: a derived platform format of an approved master campaign.
/// The master (Production) stays immutable unless explicitly re-approved;
/// variants are NEW native sequences linked to it, each recording its source
/// revision, framing overrides, safe-area report and render identity.
model ProductionVariant {
  id            String   @id @default(cuid())
  productionId  String
  production    Production @relation("Variants", fields: [productionId], references: [id], onDelete: Cascade)
  /// "16:9" | "1:1" | "9:16" (master's own aspect is not derived as a variant)
  format        String
  /// "720p" | "1080p"
  resolution    String   @default("1080p")
  fps           Int
  /// Exact duration of the master (timing preservation; overrides are explicit).
  durationSec   Float
  /// Master storyboard revision this variant derives from (immutability anchor).
  sourceStoryboardRev Int
  /// PLANNED | READY | RENDERING | COMPLETED | FAILED | CANCELLED
  status        String   @default("PLANNED")
  /// The variant's own native project (editable in the existing editor).
  projectId     String?
  /// Per-scene framing: { sceneKey: { focalPct:{x,y}, scale, offsetX, offsetY,
  /// strategy: "focal"|"center", warnings[] } } — manual edits win over auto.
  framingJson   String?
  /// Explicit timing/text overrides (each validated against the master).
  overridesJson String?
  /// Safe-area validation report (generic BEAN FX margins, not platform specs).
  safeAreaJson  String?
  renderJobId   String?
  exportId      String?
  /// Last honest failure detail.
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([productionId, format])
  @@index([productionId, status])
}

/// Append-only real production log. Only actual events are recorded — the
/// board renders this log verbatim and never fabricates activity.
model ProductionEvent {
  id           String   @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  kind         String
  stageKey     String?
  detailJson   String?
  createdAt    DateTime @default(now())
  @@index([productionId, createdAt])
}
