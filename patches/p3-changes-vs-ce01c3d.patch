--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -20,6 +20,7 @@ model User {
   exportFiles  ExportFile[]
   jobs         Job[]
   wordsToRemove WordsToRemove[]
+  cutDecisions CutDecision[]
 }
 
 /// User-defined words/phrases RIISHE should consider removing (context-aware —
@@ -111,4 +112,42 @@ model Job {
   exportId   String?
   createdAt  DateTime @default(now())
   updatedAt  DateTime @updatedAt
+
+  cutDecisions CutDecision[]
+}
+
+/// Persisted user decision for ONE candidate of ONE completed RIISHE analysis.
+/// Identity: (userId, jobId, candidateId). `jobId` is the analysis Job id
+/// (type "autocut-analysis"); `candidateId` is the stable candidate id inside
+/// the immutable result file `media-store/analysis-results/<jobId>.json`
+/// (e.g. "sil-3", "word-12", "rep-2"). Candidate data is NOT duplicated here —
+/// the result file stays the single source of truth; this table stores only
+/// the user's decision, validated server-side against the result file.
+model CutDecision {
+  id          String   @id @default(cuid())
+  userId      String
+  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
+  jobId       String
+  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
+  candidateId String
+  decision    String // APPROVE | REJECT | KEEP
+  createdAt   DateTime @default(now())
+  updatedAt   DateTime @updatedAt
+
+  @@unique([userId, jobId, candidateId])
+  @@index([jobId])
+}
+
+/// Append-only history of decision changes — a decision update adds a new
+/// event instead of overwriting history. Deliberately not FK-bound to Job:
+/// this is an audit log and survives even if a job row were ever removed.
+model CutDecisionEvent {
+  id          String   @id @default(cuid())
+  userId      String
+  jobId       String
+  candidateId String
+  decision    String
+  createdAt   DateTime @default(now())
+
+  @@index([jobId, candidateId])
 }
